# ============================================================================
# SELF TEST
# ============================================================================

def self_test() -> bool:

    bars = build_test_bars()

    swings = detect_swings(
        bars,
        left_bars=2,
        right_bars=2,
    )

    structures = classify_structure(
        swings
    )

    # --------------------------------------------------------
    # Basic swing contract
    # --------------------------------------------------------

    assert swings

    for swing in swings:

        assert (
            swing.confirmation_index
            ==
            swing.index + 2
        )

        assert (
            swing.confirmation_index
            < len(bars)
        )

    # --------------------------------------------------------
    # Audit confirmation
    # --------------------------------------------------------

    confirmation_audit = audit_swing_confirmation(
        bars,
        swings,
        right_bars=2,
    )

    assert confirmation_audit["passed"]

    # --------------------------------------------------------
    # Legacy leakage MUST be detectable.
    #
    # This proves the audit can actually catch
    # the original defect.
    # --------------------------------------------------------

    leakage_audit = audit_legacy_leakage(
        structures,
        len(bars),
    )

    assert leakage_audit["leak_count"] >= 0

    # If structure exists, at least one early
    # exposure is expected for normal right-bars.
    if structures:

        assert (
            leakage_audit["leak_count"] > 0
        )

    # --------------------------------------------------------
    # Repaired availability
    # --------------------------------------------------------

    availability_audit = audit_repaired_availability(
        structures,
        len(bars),
    )

    assert availability_audit["passed"]

    # --------------------------------------------------------
    # Event detection
    # --------------------------------------------------------

    events = detect_structure_events(
        bars,
        structures,
    )

    event_audit = audit_event_temporal_integrity(
        events
    )

    assert event_audit["passed"]

    # --------------------------------------------------------
    # End-of-series
    # --------------------------------------------------------

    end_audit = audit_end_of_series(
        bars,
        swings,
        right_bars=2,
    )

    assert end_audit["passed"]

    # --------------------------------------------------------
    # Confirmation boundary
    # --------------------------------------------------------

    boundary_audit = audit_confirmation_boundary(
        bars,
        swings,
        right_bars=2,
    )

    assert boundary_audit["passed"]

    # --------------------------------------------------------
    # Explicit boundary checks
    # --------------------------------------------------------

    for point in structures:

        before_confirmation = (
            confirmed_structure_points_at(
                structures,
                point.confirmation_index - 1,
            )
        )

        at_confirmation = (
            confirmed_structure_points_at(
                structures,
                point.confirmation_index,
            )
        )

        assert point not in (
            before_confirmation
        )

        assert point in (
            at_confirmation
        )

    return True


