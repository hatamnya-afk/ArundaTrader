    if not SIGNAL_SCORER_FILE.exists():

        fail(
            "signal_scorer.py not found."
        )

    tree = parse_tree(
        SIGNAL_SCORER_FILE
    )

    source_lines = read_text(
        SIGNAL_SCORER_FILE
    ).splitlines()

    # -------------------------------------------------------------------------
    # load_features
    # -------------------------------------------------------------------------

    matches = find_function(
        tree,
        "load_features"
    )

    if len(matches) != 1:

        fail(
            "Cannot deterministically resolve "
            "signal_scorer.load_features()."
        )

    node = matches[0]

    print(
        f"signal_scorer.load_features "
        f"@ line {node.lineno}"
    )

    print_context(
        SIGNAL_SCORER_FILE,
        source_lines,
        node.lineno,
        radius=7
    )

    # -------------------------------------------------------------------------
    # feature contract
    # -------------------------------------------------------------------------

    if not FEATURE_CONTRACT_FILE.exists():

        print()
        print(
            "FEATURE CONTRACT : NOT FOUND"
        )

    else:

        feature_tree = parse_tree(
            FEATURE_CONTRACT_FILE
        )

        feature_loader_names = {
            "load_feature_snapshot",
            "validate_feature_snapshot",
        }

        print()
        print(
            "Feature-contract functions:"
        )

        for function_name in sorted(
            feature_loader_names
        ):

            functions = find_function(
                feature_tree,
                function_name
            )

            for function in functions:

                print(
                    f"  {function_name:<35}"
                    f"LINE {function.lineno}"
                )

    # -------------------------------------------------------------------------
    # feature engine
    # -------------------------------------------------------------------------

    if FEATURE_ENGINE_FILE.exists():

        feature_tree = parse_tree(
            FEATURE_ENGINE_FILE
        )

        print()
        print(
            "Feature-engine candidate functions:"
        )

        for function_name in (
            "build_features",
            "calculate_features",
            "calculate_feature_records",
            "load_features",
            "build_all",
        ):

            functions = find_function(
                feature_tree,
                function_name
            )

            for function in functions:

                print(
                    f"  {function_name:<35}"
                    f"LINE {function.lineno}"
                )

    return True


