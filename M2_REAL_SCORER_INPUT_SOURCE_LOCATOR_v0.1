# =============================================================================
# TERMINAL HELPERS
# =============================================================================

def line(char="=", length=100):
    print(char * length)


def fail(message):
    raise RuntimeError(message)


def read_text(path):
    if not path.exists():
        fail(
            f"REQUIRED FILE NOT FOUND: {path}"
        )

    return path.read_text(
        encoding="utf-8-sig"
    )


def print_context(
    path,
    source_lines,
    line_number,
    radius=5
):
    """
    Print source context around a discovered line.
    """

    start = max(
        1,
        line_number - radius
    )

    end = min(
        len(source_lines),
        line_number + radius
    )

    for number in range(
        start,
        end + 1
    ):
        marker = (
            ">>"
            if number == line_number
            else "  "
        )

        print(
            f"{marker} "
            f"{number:>5} | "
            f"{source_lines[number - 1]}"
        )


# =============================================================================
# AST HELPERS
# =============================================================================

def parse_tree(path):
    text = read_text(path)

    try:
        return ast.parse(
            text,
            filename=str(path)
        )

    except SyntaxError as exc:
        fail(
            f"SYNTAX ERROR IN {path}: "
            f"{exc}"
        )


def find_function(
    tree,
    function_name
):
    matches = []

    for node in ast.walk(tree):

        if isinstance(
            node,
            (
                ast.FunctionDef,
                ast.AsyncFunctionDef,
            )
        ):

            if node.name == function_name:

                matches.append(
                    node
                )

    return matches


def find_imports(
    tree
):
    imports = []

    for node in ast.walk(tree):

        if isinstance(
            node,
            ast.Import
        ):

            for alias in node.names:

                imports.append(
                    alias.name
                )

        elif isinstance(
            node,
            ast.ImportFrom
        ):

            if node.module:

                imports.append(
                    node.module
                )

    return imports


def find_name_references(
    tree,
    target_names
):
    found = []

    for node in ast.walk(tree):

        if isinstance(
            node,
            ast.Name
        ):

            if node.id in target_names:

                found.append(
                    (
                        node.id,
                        getattr(
                            node,
                            "lineno",
                            None
                        )
                    )
                )

    return found


def find_call_references(
    tree,
    function_names
):
    found = []

    for node in ast.walk(tree):

        if not isinstance(
            node,
            ast.Call
        ):
            continue

        function_name = None

        if isinstance(
            node.func,
            ast.Name
        ):

            function_name = (
                node.func.id
            )

        elif isinstance(
            node.func,
            ast.Attribute
        ):

            function_name = (
                node.func.attr
            )

        if function_name in function_names:

            found.append(
                (
                    function_name,
                    getattr(
                        node,
                        "lineno",
                        None
                    )
                )
            )

    return found


# =============================================================================
# FILE / FUNCTION VERIFICATION
# =============================================================================

def verify_file(
    path,
    label
):

    print(
        f"{label:<30}: "
        f"{path}"
    )

    if not path.exists():

        print(
            " " * 30
            + "STATUS : NOT FOUND"
        )

        return False

    print(
        " " * 30
        + "STATUS : FOUND"
    )

    return True


def verify_function(
    path,
    function_name,
    label
):

    tree = parse_tree(
        path
    )

    matches = find_function(
        tree,
        function_name
    )

    if not matches:

        print(
            f"{label:<30}: "
            f"{function_name} "
            f"NOT FOUND"
        )

        return False

    if len(matches) > 1:

        print(
            f"{label:<30}: "
            f"AMBIGUOUS "
            f"({len(matches)} definitions)"
        )

        return False

    node = matches[0]

    print(
        f"{label:<30}: "
        f"{function_name} "
        f"FOUND @ LINE {node.lineno}"
    )

    return True


# =============================================================================
# SIGNAL SCORER ANALYSIS
# =============================================================================

def inspect_signal_scorer():

    print()
    line("-")
    print(
        "SIGNAL SCORER DEPENDENCY ANALYSIS"
    )
    line("-")

    if not SIGNAL_SCORER_FILE.exists():

        fail(
            "signal_scorer.py not found."
        )

    text = read_text(
        SIGNAL_SCORER_FILE
    )

    source_lines = text.splitlines()

    tree = parse_tree(
        SIGNAL_SCORER_FILE
    )

    # -------------------------------------------------------------------------
    # calculate_score
    # -------------------------------------------------------------------------

    calculate_matches = find_function(
        tree,
        "calculate_score"
    )

    if len(calculate_matches) != 1:

        fail(
            "calculate_score resolution is "
            "not deterministic."
        )

    calculate_node = (
        calculate_matches[0]
    )

    calculate_args = [
        arg.arg
        for arg in (
            calculate_node.args.args
        )
    ]

    print(
        f"calculate_score line : "
        f"{calculate_node.lineno}"
    )

    print(
        "Arguments            : "
        f"{', '.join(calculate_args)}"
    )

    required_arguments = {
        "direction",
        "feature_record",
        "structural_state",
        "regime_data",
    }

    if not required_arguments.issubset(
        set(calculate_args)
    ):

        fail(
            "calculate_score argument contract "
            "does not match expected production contract."
        )

    # -------------------------------------------------------------------------
    # load_scores
    # -------------------------------------------------------------------------

    load_matches = find_function(
        tree,
        "load_scores"
    )

    if len(load_matches) != 1:

        fail(
            "load_scores resolution is "
            "not deterministic."
        )

    load_node = load_matches[0]

    print(
        f"load_scores line      : "
        f"{load_node.lineno}"
    )

    load_calls = find_call_references(
        tree,
        {
            "load_features",
            "load_structural_states",
            "load_regimes",
            "calculate_score",
            "extract_latest_feature_record",
        }
    )

    print()
    print(
        "Production dependency calls:"
    )

    for function_name, line_number in sorted(
        load_calls,
        key=lambda item: (
            item[1] or 0,
            item[0],
        )
    ):

        print(
            f"  {function_name:<35}"
            f"LINE {line_number}"
        )

    # -------------------------------------------------------------------------
    # Imports
    # -------------------------------------------------------------------------

    imports = find_imports(
        tree
    )

    print()
    print(
        "Relevant imported modules:"
    )

    relevant_modules = [
        item
        for item in imports
        if item in {
            "feature_contract",
            "market_regime_contract",
            "market_state_engine",
            "feature_engine",
            "signal_engine",
        }
    ]

    for module in sorted(
        set(relevant_modules)
    ):

        print(
            f"  {module}"
        )

    # -------------------------------------------------------------------------
    # Context around load_features / load_regimes / structural loader
    # -------------------------------------------------------------------------

    print()
    print(
        "SOURCE CONTEXT"
    )

    for function_name in (
        "load_features",
        "load_structural_states",
        "load_regimes",
        "extract_latest_feature_record",
        "load_scores",
    ):

        matches = find_function(
            tree,
            function_name
        )

        if not matches:
            continue

        node = matches[0]

        print()
        print(
            f"[{function_name}] "
            f"LINE {node.lineno}"
        )

        print_context(
            SIGNAL_SCORER_FILE,
            source_lines,
            node.lineno,
            radius=4
        )

    return {
        "calculate_score_line":
            calculate_node.lineno,
        "load_scores_line":
            load_node.lineno,
        "calculate_args":
            calculate_args,
    }


