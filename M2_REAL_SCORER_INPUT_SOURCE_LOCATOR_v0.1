# =============================================================================
# DATABASE SAFETY CHECK
# =============================================================================

def database_safety_check():

    print()
    line("-")
    print(
        "DATABASE SAFETY"
    )
    line("-")

    db_path = (
        PROJECT_DIR
        / "arunda.db"
    )

    print(
        f"DATABASE PATH : {db_path}"
    )

    if not db_path.exists():

        print(
            "DATABASE      : NOT PRESENT"
        )

        print(
            "DATABASE WRITE: NONE"
        )

        return True

    # Read-only SQLite URI.
    # This connection is used ONLY to prove the database is readable.
    # No SQL mutation is executed.

    uri = (
        f"file:{db_path.as_posix()}"
        f"?mode=ro"
    )

    conn = None

    try:

        conn = sqlite3.connect(
            uri,
            uri=True,
            timeout=5
        )

        conn.execute(
            "PRAGMA query_only = ON"
        )

        conn.execute(
            "SELECT name FROM sqlite_master "
            "WHERE type='table' LIMIT 1"
        ).fetchone()

        print(
            "DATABASE      : READABLE"
        )

        print(
            "QUERY MODE    : READ ONLY"
        )

        print(
            "DATABASE WRITE: NONE"
        )

        return True

    finally:

        if conn is not None:

            conn.close()


