def runtime_import_check():

    print()
    line("-")
    print(
        "PRODUCTION MODULE IMPORT CHECK"
    )
    line("-")

    modules = (
        "signal_scorer",
        "feature_contract",
        "market_state_engine",
        "market_regime_contract",
    )

    imported = {}

    for module_name in modules:

        try:

            module = __import__(
                module_name
            )

            imported[
                module_name
            ] = module

            print(
                f"{module_name:<35}"
                " : IMPORT OK"
            )

        except Exception as exc:

            print(
                f"{module_name:<35}"
                f" : IMPORT FAILED"
            )

            print(
                f"    {type(exc).__name__}: "
                f"{exc}"
            )

            fail(
                "Production dependency import failed: "
                f"{module_name}"
            )

    return imported


# =============================================================================
# RUNTIME API VERIFICATION
# =============================================================================

def runtime_api_check(
    modules
):

    print()
    line("-")
    print(
        "PRODUCTION API RESOLUTION"
    )
    line("-")

    checks = (
        (
            "signal_scorer",
            "calculate_score",
        ),
        (
            "signal_scorer",
            "load_scores",
        ),
        (
            "signal_scorer",
            "load_features",
        ),
        (
            "signal_scorer",
            "load_structural_states",
        ),
        (
            "signal_scorer",
            "load_regimes",
        ),
        (
            "signal_scorer",
            "extract_latest_feature_record",
        ),
        (
            "market_state_engine",
            "load_structural_state",
        ),
        (
            "market_regime_contract",
            "load_market_regime_contract",
        ),
    )

    for module_name, function_name in checks:

        module = modules[
            module_name
        ]

        function = getattr(
            module,
            function_name,
            None
        )

        if function is None:

            fail(
                "PRODUCTION API MISSING: "
                f"{module_name}.{function_name}"
            )

        if not callable(function):

            fail(
                "PRODUCTION API NOT CALLABLE: "
                f"{module_name}.{function_name}"
            )

        try:

            signature = inspect.signature(
                function
            )

        except (
            TypeError,
            ValueError,
        ):

            signature = "<unavailable>"

        print(
            f"{module_name}."
            f"{function_name:<35}"
            f" : RESOLVED"
        )

        print(
            f"    Signature: {signature}"
        )


