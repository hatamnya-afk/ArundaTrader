    assert audit_event_contract(
        bars,
        structures,
    )

    assert audit_event_temporal_integrity(
        bars,
        structures,
    )

    assert audit_classification_contract(
        structures,
        events,
    )

    assert audit_output_contract(
        result
    )

    assert audit_identity_preservation(
        bars,
        swings,
        structures,
        events,
    )

    assert audit_lookahead_dependency(
        bars
    )

    assert audit_end_of_series(
        bars
    )

    assert audit_determinism(
        bars
    )

    return True


