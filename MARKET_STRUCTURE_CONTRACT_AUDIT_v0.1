def build_test_bars() -> List[MarketBar]:

    closes = [
        100,
        102,
        105,
        103,
        101,
        104,
        108,
        106,
        103,
        107,
        112,
        109,
        106,
        110,
        115,
        111,
        108,
        104,
    ]

    result = []

    for index, close in enumerate(closes):

        result.append(
            MarketBar(
                timestamp=index,
                high=close + 1,
                low=close - 1,
                close=close,
                open=close,
                volume=1000.0 + index,
                cmc_id=875,
                symbol="TEST",
            )
        )

    return result


# ================================================================================================
# NEGATIVE / INVALID INPUT TESTS
# ================================================================================================

def audit_invalid_inputs() -> bool:

    # Missing timestamp
    try:

        validate_bar(
            {
                "high": 10,
                "low": 5,
                "close": 8,
            }
        )

        return False

    except (ValueError, TypeError):
        pass

    # Missing high
    try:

        validate_bar(
            {
                "timestamp": 1,
                "low": 5,
                "close": 8,
            }
        )

        return False

    except (ValueError, TypeError):
        pass

    # high < low
    try:

        validate_bar(
            {
                "timestamp": 1,
                "high": 5,
                "low": 10,
                "close": 8,
            }
        )

        return False

    except ValueError:
        pass

    # NaN
    try:

        validate_bar(
            {
                "timestamp": 1,
                "high": float("nan"),
                "low": 5,
                "close": 8,
            }
        )

        return False

    except ValueError:
        pass

    # Infinity
    try:

        validate_bar(
            {
                "timestamp": 1,
                "high": float("inf"),
                "low": 5,
                "close": 8,
            }
        )

        return False

    except ValueError:
        pass

    # Negative volume
    try:

        validate_bar(
            {
                "timestamp": 1,
                "high": 10,
                "low": 5,
                "close": 8,
                "volume": -1,
            }
        )

        return False

    except ValueError:
        pass

    # Insufficient bars
    try:

        validate_bars(
            build_test_bars()[:2]
        )

        return False

    except ValueError:
        pass

    # Reverse chronology
    try:

        validate_bars(
            [
                MarketBar(
                    timestamp=2,
                    high=10,
                    low=8,
                    close=9,
                ),
                MarketBar(
                    timestamp=1,
                    high=11,
                    low=8,
                    close=10,
                ),
                MarketBar(
                    timestamp=3,
                    high=12,
                    low=9,
                    close=11,
                ),
            ]
        )

        return False

    except ValueError:
        pass

    return True


# ================================================================================================
# INPUT CONTRACT
# ================================================================================================

def audit_input_contract(
    bars: List[MarketBar],
) -> bool:

    try:

        validated = validate_bars(bars)

        if len(validated) != len(bars):
            return False

        for bar in validated:

            if not math.isfinite(bar.high):
                return False

            if not math.isfinite(bar.low):
                return False

            if not math.isfinite(bar.close):
                return False

            if bar.high < bar.low:
                return False

        return True

    except Exception:
        return False


# ================================================================================================
# IDENTITY CONTRACT
# ================================================================================================

def audit_identity_preservation(
    bars: List[MarketBar],
    swings: List[SwingPoint],
    structures: List[StructurePoint],
    events: List[StructureEvent],
) -> bool:

    source = {
        index: bar
        for index, bar in enumerate(bars)
    }

    for swing in swings:

        if swing.cmc_id != source[swing.index].cmc_id:
            return False

        if swing.symbol != source[swing.index].symbol:
            return False

    for point in structures:

        if point.cmc_id != source[point.index].cmc_id:
            return False

        if point.symbol != source[point.index].symbol:
            return False

    for event in events:

        if event.cmc_id != source[event.index].cmc_id:
            return False

        if event.symbol != source[event.index].symbol:
            return False

    return True


# ================================================================================================
# SWING CONTRACT
# ================================================================================================

def audit_swing_contract(
    bars: List[MarketBar],
) -> bool:

    highs = detect_swing_highs(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    lows = detect_swing_lows(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    all_swings = detect_swings(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    if not all(
        point.swing_type == "SWING_HIGH"
        for point in highs
    ):
        return False

    if not all(
        point.swing_type == "SWING_LOW"
        for point in lows
    ):
        return False

    if len(all_swings) != (
        len(highs) + len(lows)
    ):
        return False

    for point in all_swings:

        validate_swing_point(point)

        if point.index < 0:
            return False

        if point.index >= len(bars):
            return False

        if point.confirmation_index != (
            point.index + RIGHT_BARS
        ):
            return False

        if point.confirmation_index >= len(bars):
            return False

        source = bars[point.index]

        expected_price = (
            source.high
            if point.swing_type == "SWING_HIGH"
            else source.low
        )

        if point.price != expected_price:
            return False

    return True


# ================================================================================================
# STRUCTURE CONTRACT
# ================================================================================================

def audit_structure_contract(
    swings: List[SwingPoint],
) -> bool:

    structures_a = classify_structure(
        swings
    )

    structures_b = classify_swing_structure(
        swings
    )

    if structures_a != structures_b:
        return False

    for point in structures_a:

        validate_structure_point(point)

        if point.structure_type not in {
            "HH",
            "HL",
            "LH",
            "LL",
        }:
            return False

        if point.swing_type not in {
            "SWING_HIGH",
            "SWING_LOW",
        }:
            return False

        if point.previous_price is None:
            return False

    return True


# ================================================================================================
# EVENT CONTRACT
# ================================================================================================

def audit_event_contract(
    bars: List[MarketBar],
    structures: List[StructurePoint],
) -> bool:

    bos = detect_bos(
        bars,
        structures,
    )

    choch = detect_choch(
        bars,
        structures,
    )

    unified = detect_structure_events(
        bars,
        structures,
    )

    # ------------------------------------------------------------------
    # BOS API must return BOS only.
    # ------------------------------------------------------------------

    if not all(
        event.event_type == "BOS"
        for event in bos
    ):
        return False

    # ------------------------------------------------------------------
    # CHoCH API must return CHoCH only.
    # ------------------------------------------------------------------

    if not all(
        event.event_type == "CHoCH"
        for event in choch
    ):
        return False

    # ------------------------------------------------------------------
    # Unified events must use allowed contracts.
    # ------------------------------------------------------------------

    for event in unified:

        validate_structure_event(event)

        if event.event_type not in {
            "BOS",
            "CHoCH",
        }:
            return False

        if event.direction not in {
            "BULLISH",
            "BEARISH",
        }:
            return False

        if event.index < 0:
            return False

        if event.index >= len(bars):
            return False

        if event.broken_price is None:
            return False

        if not math.isfinite(
            event.broken_price
        ):
            return False

    return True


# ================================================================================================
# EVENT TEMPORAL CONTRACT
# ================================================================================================

def audit_event_temporal_integrity(
    bars: List[MarketBar],
    structures: List[StructurePoint],
) -> bool:

    events = detect_structure_events(
        bars,
        structures,
    )

    structure_by_index = {
        point.index: point
        for point in structures
    }

    for event in events:

        candidates = [
            point
            for point in structures
            if (
                point.index < event.index
                and
                (
                    (
                        event.direction == "BULLISH"
                        and
                        point.swing_type == "SWING_HIGH"
                    )
                    or
                    (
                        event.direction == "BEARISH"
                        and
                        point.swing_type == "SWING_LOW"
                    )
                )
            )
        ]

        if not candidates:
            return False

        broken = candidates[-1]

        if event.broken_price != broken.price:
            return False

        if broken.index >= event.index:
            return False

        if event.index not in range(
            len(bars)
        ):
            return False

    return True


# ================================================================================================
# LOOK-AHEAD DEPENDENCY CONTRACT
# ================================================================================================

def audit_lookahead_dependency(
    bars: List[MarketBar],
) -> bool:

    # This is intentionally NOT a new forensic audit.
    #
    # The dedicated LOOKAHEAD CONTRACT REPAIR has already been
    # verified. Here we only verify that the engine's observable
    # contract remains compatible with the repaired boundary.

    if not lookahead_audit(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    ):
        return False

    swings = detect_swings(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    for swing in swings:

        # Before confirmation the swing must not be considered
        # confirmed by the contract.
        if swing.confirmation_index <= swing.index:
            return False

        # At confirmation it becomes available.
        if swing.confirmation_index >= len(bars):
            return False

    return True


# ================================================================================================
# OUTPUT CONTRACT
# ================================================================================================

def audit_output_contract(
    result: Dict[str, Any],
) -> bool:

    if result.get("engine") != ENGINE_NAME:
        return False

    if not validate_market_structure_output(
        result
    ):
        return False

    expected = {
        "engine",
        "bars",
        "swings",
        "structure_points",
        "events",
        "direction",
        "strength",
        "confidence",
    }

    if set(result.keys()) != expected:
        return False

    return True


# ================================================================================================
# DIRECTION / STRENGTH / CONFIDENCE CONTRACT
# ================================================================================================

def audit_classification_contract(
    structures: List[StructurePoint],
    events: List[StructureEvent],
) -> bool:

    direction = classify_structure_direction(
        structures
    )

    strength = calculate_structure_strength(
        structures
    )

    confidence = calculate_structure_confidence(
        structures,
        events,
    )

    if direction not in ALLOWED_DIRECTIONS:
        return False

    if strength not in ALLOWED_STRENGTH:
        return False

    if confidence not in ALLOWED_CONFIDENCE:
        return False

    return True


# ================================================================================================
# DETERMINISM CONTRACT
# ================================================================================================

def audit_determinism(
    bars: List[MarketBar],
) -> bool:

    result_a = analyze_market_structure(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    result_b = analyze_market_structure(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    return result_a == result_b


# ================================================================================================
# END-OF-SERIES CONTRACT
# ================================================================================================

def audit_end_of_series(
    bars: List[MarketBar],
) -> bool:

    swings = detect_swings(
        bars,
        LEFT_BARS,
        RIGHT_BARS,
    )

    last_possible_confirmed_index = (
        len(bars) - RIGHT_BARS - 1
    )

    for swing in swings:

        if swing.index > last_possible_confirmed_index:
            return False

        if swing.confirmation_index >= len(bars):
            return False

    return True


